POSTGRES_DB=workpin
POSTGRES_USER=workpin
POSTGRES_PASSWORD=workpin_local_only
WEB_PORT=8080
API_PORT=8081
DATABASE_URL=postgres://workpin:workpin_local_only@postgres:5432/workpin?sslmode=disable
AUTH_ACCESS_TTL=12h
AUTH_REFRESH_TTL=720h
# Keep false for local HTTP. Set true behind HTTPS in production.
AUTH_COOKIE_SECURE=false
